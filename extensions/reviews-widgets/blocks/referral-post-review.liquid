{% comment %}
  Post-review referral block — also triggered automatically after review submit
  when the post_review widget is active in dashboard settings.
{% endcomment %}

{% liquid
  if block.settings.api_base_url != blank
    assign referral_endpoint = block.settings.api_base_url | append: '/api/storefront/referrals'
  else
    assign referral_endpoint = '/apps/outrage-reviews/referrals'
  endif
%}

<section
  class="or-referral or-referral--post-review"
  data-outrage-referral
  data-widget="post_review"
  data-source="post_review"
  data-mode="advocate"
  data-shop="{{ shop.permanent_domain }}"
  data-endpoint="{{ referral_endpoint | escape }}"
  data-product-title="{{ product.title | escape }}"
  {{ block.shopify_attributes }}
  hidden
></section>

<script src="{{ 'referral-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Referral post-review",
  "target": "section",
  "stylesheet": "reviews-widget.css",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "API base URL (optional)"
    }
  ]
}
{% endschema %}
