{% comment %}
  Post-purchase referral invite (thank-you / order status page sections).
{% endcomment %}

{% liquid
  if block.settings.api_base_url != blank
    assign referral_endpoint = block.settings.api_base_url | append: '/api/storefront/referrals'
  else
    assign referral_endpoint = '/apps/outrage-reviews/referrals'
  endif
%}

<section
  class="or-referral or-referral--post-purchase"
  data-outrage-referral
  data-widget="post_purchase"
  data-source="post_purchase"
  data-mode="advocate"
  data-shop="{{ shop.permanent_domain }}"
  data-endpoint="{{ referral_endpoint | escape }}"
  {{ block.shopify_attributes }}
  hidden
></section>

<script src="{{ 'referral-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Referral post-purchase",
  "target": "section",
  "stylesheet": "reviews-widget.css",
  "templates": ["index", "page", "product", "collection", "cart", "list-collections", "search", "blog", "article", "password", "404"],
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "API base URL (optional)"
    }
  ]
}
{% endschema %}
