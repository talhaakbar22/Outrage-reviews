{% comment %}
  Store-wide “All reviews” / What customers say across every product.
  Place on Home, a dedicated Reviews page, or Collection templates.
{% endcomment %}

{% liquid
  if block.settings.api_base_url != blank
    assign summary_endpoint = block.settings.api_base_url | append: '/api/storefront/customer-say-store'
  else
    assign summary_endpoint = '/apps/outrage-reviews/customer-say-store'
  endif
%}

<div {{ block.shopify_attributes }}>
  <section
    class="or-customer-say or-customer-say--store"
    data-outrage-customer-say
    data-scope="shop"
    data-endpoint="{{ summary_endpoint | escape }}"
    data-reviews-page-size="{{ block.settings.reviews_page_size }}"
    data-star-color="{{ block.settings.star_color | escape }}"
  >
    <div class="or-customer-say__shell">
      <div class="or-customer-say__hero">
        <div class="or-customer-say__score">
          <p class="or-customer-say__average" data-outrage-average>—</p>
          <div data-outrage-score-stars>
            {% render 'stars', rating: 0, size: 20, color: '#18181B' %}
          </div>
          <p class="or-customer-say__verified" data-outrage-verified-count>
            Loading reviews…
          </p>
        </div>

        <div class="or-customer-say__summary">
          <div class="or-customer-say__summary-header">
            <h2 class="or-customer-say__heading">
              {{ block.settings.heading | default: 'What customers say' }}
            </h2>
          </div>
          <p class="or-customer-say__text" data-outrage-summary-text>
            Loading customer summary…
          </p>
          <p class="or-customer-say__meta" data-outrage-summary-meta hidden></p>
        </div>
      </div>

      <div class="or-customer-say__tags" data-outrage-highlights hidden></div>
      <div class="or-customer-say__snippets" data-outrage-snippets hidden></div>

      <div class="or-customer-say__actions" data-outrage-actions hidden>
        <button type="button" class="or-customer-say__toggle" data-outrage-toggle-reviews>
          Read all reviews
        </button>
      </div>

      <div class="or-customer-say__listing" data-outrage-listing hidden>
        <button type="button" class="or-customer-say__toggle" data-outrage-hide-reviews>
          Hide reviews
        </button>

        <div
          class="or-customer-say__filter-banner"
          data-outrage-highlight-filter
          hidden
        >
          <p class="or-customer-say__filter-text" data-outrage-highlight-filter-label></p>
          <button type="button" class="or-customer-say__filter-clear" data-outrage-clear-highlight>
            Show all reviews
          </button>
        </div>

        <div class="or-customer-say__reviews" data-outrage-reviews-panel>
          <div class="or-customer-say__reviews-list" data-outrage-reviews-list></div>
          <p class="or-customer-say__reviews-empty" data-outrage-reviews-empty hidden>
            No published reviews yet.
          </p>
          <p class="or-customer-say__reviews-error" data-outrage-reviews-error hidden></p>
          <button type="button" class="or-customer-say__load-more" data-outrage-load-more hidden>
            Load more reviews
          </button>
        </div>
      </div>
    </div>
  </section>
  <script src="{{ 'customer-say-widget.js' | asset_url }}" defer></script>
</div>

{% schema %}
{
  "name": "All store reviews",
  "target": "section",
  "stylesheet": "reviews-widget.css",
  "enabled_on": {
    "templates": ["index", "page", "collection", "product", "cart", "list-collections", "search", "blog", "article", "password", "404"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows every approved review across your store (like Loox’s all-reviews gallery). Best on Home or a dedicated Reviews page. After enabling, Save the theme."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say"
    },
    {
      "type": "range",
      "id": "reviews_page_size",
      "min": 5,
      "max": 20,
      "step": 1,
      "label": "Reviews per page",
      "default": 10
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#18181B"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "Direct app URL (advanced)",
      "info": "Leave blank. Uses /apps/outrage-reviews/customer-say-store via app proxy."
    }
  ]
}
{% endschema %}
