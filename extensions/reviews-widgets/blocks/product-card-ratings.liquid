{% comment %}
  App embed (Loox-style): injects star rating + review count under product titles
  site-wide — collections, featured grids, search, predictive search, related
  products, cart, cart drawer, AND the product page title.

  Enable once: Theme settings → App embeds → Product card ratings → ON → Save.

  Do NOT add the "Star rating" section block to Collection → Apps. This theme's
  Collection section does not accept @app blocks inside the product grid.
{% endcomment %}

{% liquid
  if block.settings.api_base_url != blank
    assign ratings_endpoint = block.settings.api_base_url | append: '/api/storefront/product-ratings'
  else
    assign ratings_endpoint = '/apps/outrage-reviews/product-ratings'
  endif
%}

<div {{ block.shopify_attributes }}>
  <div
    data-outrage-card-ratings
    data-endpoint="{{ ratings_endpoint | escape }}"
    data-star-size="{{ block.settings.star_size }}"
    data-star-color="{{ block.settings.star_color | escape }}"
    data-show-count="{% if block.settings.show_count %}true{% else %}false{% endif %}"
    data-show-empty="{% if block.settings.show_empty %}true{% else %}false{% endif %}"
    data-include-pdp="{% if block.settings.include_pdp %}true{% else %}false{% endif %}"
    hidden
  ></div>
  <script src="{{ 'product-card-ratings.js' | asset_url }}" defer></script>
</div>

{% schema %}
{
  "name": "Product card ratings",
  "target": "body",
  "stylesheet": "reviews-widget.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows stars under every product name store-wide (collections, search, cart, product page). Turn this App embed ON once — Theme settings → App embeds. This is the correct Loox-style setup. Do not use the Star rating section block on collection pages."
    },
    {
      "type": "checkbox",
      "id": "include_pdp",
      "label": "Also show under the product page title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show rating number and review count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_empty",
      "label": "Show “No reviews yet” when a product has no reviews",
      "default": true
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Star size",
      "default": 14
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#18181B"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "API base URL (optional)",
      "info": "Leave blank to use the app proxy (/apps/outrage-reviews/...)."
    }
  ]
}
{% endschema %}
