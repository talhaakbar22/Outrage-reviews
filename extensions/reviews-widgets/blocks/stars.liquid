{% comment %}
  Optional PDP-only star block (for themes that allow @app blocks inside
  Product information). For collections / search / cart / under EVERY title,
  enable the App embed "Product card ratings" instead — Collection sections
  often do not support app blocks ("No app blocks available for this section").
{% endcomment %}

{% liquid
  assign rating_product = block.settings.product
  if rating_product == blank
    assign rating_product = closest.product | default: product
  endif

  assign rating_value = 0
  assign review_count = 0

  if rating_product
    assign rating_mf = rating_product.metafields.reviews.rating
    assign count_mf = rating_product.metafields.reviews.rating_count
    if count_mf == blank
      assign count_mf = rating_product.metafields.reviews.count
    endif

    if rating_mf != blank
      if rating_mf.value.rating != blank
        assign rating_value = rating_mf.value.rating | plus: 0
      elsif rating_mf.value.value != blank
        assign rating_value = rating_mf.value.value | plus: 0
      elsif rating_mf.value != blank
        assign rating_value = rating_mf.value | plus: 0
      endif
    endif

    if count_mf != blank
      if count_mf.value != blank
        assign review_count = count_mf.value | plus: 0
      else
        assign review_count = count_mf | plus: 0
      endif
    endif
  endif

  assign show_empty = block.settings.show_empty
  assign show_count = block.settings.show_count
  assign star_size = block.settings.star_size
  assign star_color = block.settings.star_color | default: '#18181B'
  assign layout = block.settings.layout | default: 'card'
%}

{% if rating_product %}
  {% if review_count > 0 or show_empty %}
    <div
      class="or-stars{% if layout == 'card' %} or-stars--card{% endif %}{% if layout == 'inline' %} or-stars--inline{% endif %}"
      data-outrage-stars
      data-product-id="{{ rating_product.id }}"
      style="--or-star-size: {{ star_size }}px; --or-star-color: {{ star_color }};"
      {{ block.shopify_attributes }}
    >
      {% if review_count > 0 %}
        {% render 'stars', rating: rating_value, size: star_size, color: star_color %}

        {% if show_count %}
          <span class="or-stars__count">
            {{ rating_value | round: 1 }}
            ·
            {{ review_count }}
            {% if review_count == 1 %}review{% else %}reviews{% endif %}
          </span>
        {% endif %}
      {% else %}
        {% if block.settings.show_empty_stars %}
          {% render 'stars', rating: 0, size: star_size, color: star_color %}
        {% endif %}
        {% if show_count %}
          <span class="or-stars__count or-stars__count--empty">
            {{ block.settings.empty_label }}
          </span>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Star rating (PDP only)",
  "target": "section",
  "stylesheet": "reviews-widget.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Optional on the product page only. For stars under titles on collections, search, and cart: Theme settings → App embeds → enable Product card ratings. Collection sections usually cannot host this block."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true,
      "info": "Leave blank — autofill uses the current product."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "card", "label": "Under product title" },
        { "value": "inline", "label": "Inline" }
      ],
      "default": "card"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show rating and review count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_empty",
      "label": "Show when there are no reviews",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_empty_stars",
      "label": "Show empty stars when there are no reviews",
      "default": false
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Empty state label",
      "default": "No reviews yet"
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Star size",
      "default": 14
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#18181B"
    }
  ]
}
{% endschema %}
