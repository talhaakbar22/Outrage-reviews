rules_version = '2';

// Outrage Reviews media in Firebase Storage (outrageldn-dashboard).
// Object layout:
//   review-media/{shopId}/pending/{uploadSessionOrRequestId}/{file}  — inbound uploads
//   review-media/{shopId}/{reviewId}/{mediaId}/{full|thumb}.webp     — processed
//
// Writes go through Admin SDK / signed GCS URLs / the Next.js upload proxy
// (those paths bypass these rules). Public read is for storefront widgets.

service firebase.storage {
  match /b/{bucket}/o {
    match /review-media/{shopId}/pending/{ownerId}/{fileName} {
      allow read, write: if false;
    }

    match /review-media/{shopId}/{reviewId}/{mediaId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
