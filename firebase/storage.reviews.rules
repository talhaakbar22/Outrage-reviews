rules_version = '2';

// FRAGMENT for Outrage Reviews media in Firebase Storage.
// Merge into the shared project storage rules before deploying.
// Object layout: review-media/{shopId}/{reviewId}/{filename}

service firebase.storage {
  match /b/{bucket}/o {
    match /review-media/{shopId}/{reviewId}/{fileName} {
      // Public read for published review widgets (URLs are unguessable enough with UUID paths).
      // Writes only via Admin SDK / signed uploads from the Next.js API.
      allow read: if true;
      allow write: if false;
    }
  }
}
